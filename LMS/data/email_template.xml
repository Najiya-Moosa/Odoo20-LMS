<?xml version="1.0" ?>
    <data>
        <record id="email_template_name" model="mail.template">
            <field name="name">ENROLLMENT COMPLETED</field>
       <field name="model_id" ref="model_lms_enrollment"/>
            <field name="subject">{{ object.reference }}</field>
            <field name="use_default_to" eval="False"/>

            <field name="email_from">
                {{ user.email_formatted or user.company_id.email_formatted }}
            </field>
            <field name="email_to"> {{ object.student_id.email }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>
                       Hello <span style="font-weight: bold;" t-out="object.student_id.name"/>,
                        <br/>
                        Your enrollment in <span t-out="object.course_id.name"/> is confirmed. We are glad to have you join us.
                        <br/>
                        <br/>
                        Course details,
                        <br/>
                        Enrollment id : <span  t-out="object.reference"/>
                        <br/>
                        Course name : <span  t-out="object.course_id.name"/>
                        <br/>
                        Course fee : <span  t-out="object.course_fee"/>
                        <br/>

                        <br/>
                        Mitchell Admin
                    </p>
                </div>
            </field>
        </record>
    </data>
<?xml version="1.0" ?>
<odoo>
    <data noupdate="0">
        <record id="daily_check_invoice" model="ir.cron">
            <field name="name">send invoice</field>
            <field name="model_id" ref="model_lms_enrollment"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_due_invoices()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name='interval_number'>1</field>
            <field name='interval_type'>days</field>
            <field name="nextcall"
                  eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 12:00:00')"/>
           <field name="priority">1</field>
        </record>
    </data>
</odoo>
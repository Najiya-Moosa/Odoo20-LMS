<?xml version="1.0" ?>
<odoo>
    <record id="lms_student_account_action" model="ir.actions.act_window">
        <field name="name">student account</field>
        <field name="res_model">lms.student.account</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="lms_account_list_view" model="ir.ui.view">
        <field name="name">student.account.list</field>
        <field name="model">lms.student.account</field>
        <field name="arch" type="xml">
            <list>
                <field name="account_id"/>
            </list>
        </field>
    </record>
</odoo>


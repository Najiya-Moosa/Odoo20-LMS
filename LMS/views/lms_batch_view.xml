<?xml version="1.0"  ?>

<odoo>

    <record id="lms_batch_model_action" model="ir.actions.act_window">
        <field name="name">Batches</field>
        <field name="res_model">lms.batch</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="lms_batch_form_view" model="ir.ui.view">
        <field name="name">batch list</field>
        <field name="model">lms.batch</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="create_invoice" class="btn btn-primary"  type="object" string="Run Billing" invisible="to_invoice==0"/>
                </header>
                <sheet>
                    <div class="button_box" name="button_box">
                    <button class="oe_stat_button"
                        name="stat_button"
                        type="object"
                        string="students"
                        icon="personal">
                        <field name="student_count" widget="statinfo" string="students"/>
                    </button>
                     <button class="oe_stat_button" name="stat_button_invoice"
                             type="object" string="invoice" icon="edit_square">
                         <field name="invoice_count" widget="statinfo" string="Invoices"/>
                     </button>
                    </div>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="course_id"/>
                            <field name="enrollment_ids" widget="many2many_tags" domain="[('course_id','=',course_id)]"/>
<!--                            <field name="student_count"/>-->
                        </group>
                        <group>
                            <field name="capacity"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="total_course_fee" widget="monetary"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="to_invoice"/>
<!--                            <field name="student_count"/>-->
                        </group>
                    </group>
                    <notebook>
                        <page string="scholarships">
                            <field name="scholarship_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="enrollment_id"/>
                                    <field name="stage_selection"/>
                                    <field name="discount_amount"/>

                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="batch_list_view" model="ir.ui.view">
        <field name="name">student list</field>
        <field name="model">lms.batch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="course_id"/>
                <field name="student_count"/>
                <field name="capacity"/>
            </list>
        </field>
    </record>
    <record id="batch_search" model="ir.ui.view">
        <field name="name">search batch</field>
        <field name="model">lms.batch</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="capacity"/>
                <field name="student_count"/>
                <filter string="archived"
                        domain="[('active','=',False)]"
                        name="active"/>

            </search>

        </field>


    </record>
</odoo>
